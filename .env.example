# Copy this file to ".env" (same folder) and fill in your own values.
# .env is personal: it is git-ignored. Never commit or share it.

# Your OpenRouter API key (https://openrouter.ai -> Keys)
OPENROUTER_API_KEY=sk-or-PASTE-YOURS

# Where requests go
SCIWRITE_LLM_ENDPOINT=https://openrouter.ai/api/v1
SCIWRITE_VISION_ENDPOINT=https://openrouter.ai/api/v1

# Which models to use. The vision model must accept images.
# Free models end in ":free". Record which model produced your results.
SCIWRITE_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
SCIWRITE_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
